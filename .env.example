# =============================================================================
#  bourse-project - Variables d'environnement
# -----------------------------------------------------------------------------
#  Copier ce fichier en `.env` puis ajuster les valeurs :
#      cp .env.example .env
#
#  Le fichier `.env` n'est JAMAIS versionne (voir .gitignore).
#  Sur Streamlit Cloud, ces cles se declarent dans
#  "App settings > Secrets" au format TOML (KEY = "value").
# =============================================================================

# --- Collecte de donnees ----------------------------------------------------
# Profondeur d'historique telechargee depuis Yahoo Finance.
# Valeurs acceptees : 1mo, 3mo, 6mo, 1y, 2y, 5y, 10y, ytd, max
BOURSE_PERIOD=2y

# Granularite des bougies. Pour des chandeliers journaliers : 1d
# Valeurs acceptees : 1d, 5d, 1wk, 1mo, 3mo
BOURSE_INTERVAL=1d

# --- Stockage ---------------------------------------------------------------
# Repertoire racine des donnees (relatif a la racine du projet ou absolu).
BOURSE_DATA_DIR=data

# --- Reseau -----------------------------------------------------------------
# Nombre de telechargements en parallele. Yahoo Finance limite le debit :
# rester entre 2 et 6 pour eviter les erreurs 429 (Too Many Requests).
BOURSE_MAX_WORKERS=4

# Pause (en secondes) entre deux requetes d'un meme worker.
BOURSE_THROTTLE_SECONDS=0.4

# Nombre de tentatives par ticker en cas d'echec reseau.
BOURSE_RETRY_ATTEMPTS=3

# Facteur de backoff exponentiel entre deux tentatives (secondes).
BOURSE_RETRY_BACKOFF=1.8

# --- Journalisation ---------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
BOURSE_LOG_LEVEL=INFO

# --- Interface Streamlit ----------------------------------------------------
APP_TITLE=Analyse boursiere - S&P 500 / Nasdaq / CAC 40
APP_DEFAULT_TICKERS=AAPL,MSFT,MC.PA
APP_DEFAULT_CHART=Chandeliers japonais
